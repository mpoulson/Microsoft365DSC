[ClassVersion("1.0.0.1"), FriendlyName("AADTenantGovernanceRelationship")]
class MSFT_AADTenantGovernanceRelationship : OMI_BaseResource
{
    [Key, Description("The unique identifier of the governance relationship.")] String Id;
    [Write, Description("The Microsoft Entra tenant identifier of the governed tenant.")] String GovernedTenantId;
    [Write, Description("The display name of the governed tenant.")] String GovernedTenantName;
    [Write, Description("The Microsoft Entra tenant identifier of the governing tenant.")] String GoverningTenantId;
    [Write, Description("The display name of the governing tenant.")] String GoverningTenantName;
    [Write, Description("The date and time when the relationship was created.")] String CreationDateTime;
    [Write, Description("The current status of the governance relationship."), ValueMap{"active","terminated","terminationRequestedByGoverningTenant","unknownFutureValue"}, Values{"active","terminated","terminationRequestedByGoverningTenant","unknownFutureValue"}] String Status;
    [Write, Description("The method used to create the relationship."), ValueMap{"approvedByAdmin","addOnTenant","unknownFutureValue"}, Values{"approvedByAdmin","addOnTenant","unknownFutureValue"}] String CreatedType;
    [Write, Description("The governance policy snapshot applied to the relationship."), EmbeddedInstance("MSFT_AADTenantGovernanceRelationshipPolicySnapshot")] String PolicySnapshot;
    [Write, Description("Present ensures the relationship exists, and absent checks that it does not exist. Relationships cannot be created or deleted directly."), ValueMap{"Present","Absent"}, Values{"Present","Absent"}] String Ensure;
    [Write, Description("Credentials of the workload administrator."), EmbeddedInstance("MSFT_Credential")] String Credential;
    [Write, Description("Identifier of the Microsoft Entra application used for authentication.")] String ApplicationId;
    [Write, Description("Identifier of the Microsoft Entra tenant used for authentication.")] String TenantId;
    [Write, Description("Secret of the Microsoft Entra application used for authentication."), EmbeddedInstance("MSFT_Credential")] String ApplicationSecret;
    [Write, Description("Thumbprint of the Microsoft Entra application's authentication certificate.")] String CertificateThumbprint;
    [Write, Description("Path to the Microsoft Entra application's authentication certificate.")] String CertificatePath;
    [Write, Description("Password for the Microsoft Entra application's authentication certificate."), EmbeddedInstance("MSFT_Credential")] String CertificatePassword;
    [Write, Description("Indicates whether managed identity authentication is used.")] Boolean ManagedIdentity;
    [Write, Description("Access tokens used for authentication.")] String AccessTokens[];
};
