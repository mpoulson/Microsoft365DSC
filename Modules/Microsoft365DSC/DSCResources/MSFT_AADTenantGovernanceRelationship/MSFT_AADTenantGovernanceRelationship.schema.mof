[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernanceRelationshipRoleTemplate
{
    [Write, Description("The template ID of the Microsoft Entra role.")] String Id;
    [Write, Description("The display name of the role.")] String Name;
};

[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernanceRelationshipDelegatedAdminRoleAssignmentSnapshot
{
    [Write, Description("The display name of the security group.")] String GroupDisplayName;
    [Write, Description("The object ID of the security group.")] String GroupId;
    [Write, Description("A collection of role templates for the assignment."), EmbeddedInstance("MSFT_AADTenantGovernanceRelationshipRoleTemplate")] String RoleTemplates[];
};

[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernanceRelationshipPolicySnapshot
{
    [Write, Description("The identifier of the source policy template.")] String PolicyId;
    [Write, Description("Whether the governed tenant can terminate the relationship.")] Boolean GovernedTenantCanTerminate;
    [Write, Description("A snapshot of the delegated admin role assignments."), EmbeddedInstance("MSFT_AADTenantGovernanceRelationshipDelegatedAdminRoleAssignmentSnapshot")] String DelegatedAdministrationRoleAssignments[];
};

[ClassVersion("1.0.0.0"), FriendlyName("AADTenantGovernanceRelationship")]
class MSFT_AADTenantGovernanceRelationship : OMI_BaseResource
{
    [Key, Description("The Microsoft Entra tenant ID of the governed tenant.")] String GovernedTenantId;
    [Write, Description("The unique identifier for the governance relationship. Read-only.")] String Id;
    [Write, Description("The display name of the governed tenant. Read-only.")] String GovernedTenantName;
    [Write, Description("The Microsoft Entra tenant ID of the governing tenant. Read-only.")] String GoverningTenantId;
    [Write, Description("The display name of the governing tenant. Read-only.")] String GoverningTenantName;
    [Write, Description("The current status of the governance relationship."), ValueMap{"active","terminated","terminationRequestedByGoverningTenant","unknownFutureValue"}, Values{"active","terminated","terminationRequestedByGoverningTenant","unknownFutureValue"}] String Status;
    [Write, Description("How the relationship was created."), ValueMap{"approvedByAdmin","addOnTenant","unknownFutureValue"}, Values{"approvedByAdmin","addOnTenant","unknownFutureValue"}] String CreatedType;
    [Write, Description("A snapshot of the governance policy applied to this relationship."), EmbeddedInstance("MSFT_AADTenantGovernanceRelationshipPolicySnapshot")] String PolicySnapshot;
    [Write, Description("Present ensures the relationship is monitored. Can only be set to Present since relationships cannot be directly created or deleted."), ValueMap{"Present"}, Values{"Present"}] String Ensure;
    [Write, Description("Credentials of the Admin"), EmbeddedInstance("MSFT_Credential")] string Credential;
    [Write, Description("Id of the Azure Active Directory application to authenticate with.")] String ApplicationId;
    [Write, Description("Id of the Azure Active Directory tenant used for authentication.")] String TenantId;
    [Write, Description("Secret of the Azure Active Directory tenant used for authentication."), EmbeddedInstance("MSFT_Credential")] String ApplicationSecret;
    [Write, Description("Thumbprint of the Azure Active Directory application's authentication certificate to use for authentication.")] String CertificateThumbprint;
    [Write, Description("Managed ID being used for authentication.")] Boolean ManagedIdentity;
    [Write, Description("Access token used for authentication.")] String AccessTokens[];
};
