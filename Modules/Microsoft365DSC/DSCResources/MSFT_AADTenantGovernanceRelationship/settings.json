{
  "resourceName": "AADTenantGovernanceRelationship",
  "description": "This resource monitors and manages Azure AD Tenant Governance Relationships between governing and governed tenants.",
  "permissions": {
    "graph": {
      "delegated": {
        "read": [
          {
            "name": "Policy.Read.All"
          }
        ],
        "update": [
          {
            "name": "Policy.ReadWrite.TenantGovernance"
          }
        ]
      },
      "application": {
        "read": [
          {
            "name": "Policy.Read.All"
          }
        ],
        "update": [
          {
            "name": "Policy.ReadWrite.TenantGovernance"
          }
        ]
      }
    }
  },
  "requiredModules": [
    "Microsoft.Graph.Authentication"
  ],
  "supportedEnvironments": [
    "Global"
  ],
  "mode": "Configuration",
  "commands": [
    {
      "module": "Microsoft.Graph.Authentication",
      "cmdlets": [
        "Invoke-MgGraphRequest"
      ]
    }
  ]
}
