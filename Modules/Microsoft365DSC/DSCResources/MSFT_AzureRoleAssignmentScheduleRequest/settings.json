{
  "resourceName": "AzureRoleAssignmentScheduleRequest",
  "description": "This resource configures an Azure Privilege Identity Management active role assignment schedule request for Azure resources.",
  "roles": {
    "read": [
      "Security Reader"
    ],
    "update": [
      "Privileged Role Administrator"
    ]
  },
  "permissions": {
    "graph": {
      "application": {
        "read": [
          {
            "name": "RoleManagement.Read.All"
          }
        ],
        "update": [
          {
            "name": "RoleManagement.ReadWrite.All"
          }
        ]
      }
    }
  },
  "requiredModules": [
    "Microsoft.Graph.Applications",
    "Microsoft.Graph.Authentication",
    "Microsoft.Graph.Beta.DirectoryObjects",
    "Microsoft.Graph.Groups",
    "Microsoft.Graph.Users"
  ],
  "supportedEnvironments": [
    "Global",
    "USGov"
  ],
  "mode": "Configuration",
  "commands": [
    {
      "module": "Microsoft.Graph.Applications",
      "cmdlets": [
        "Get-MgServicePrincipal"
      ]
    },
    {
      "module": "Microsoft.Graph.Beta.DirectoryObjects",
      "cmdlets": [
        "Get-MgBetaDirectoryObjectById"
      ]
    },
    {
      "module": "Microsoft.Graph.Groups",
      "cmdlets": [
        "Get-MgGroup"
      ]
    },
    {
      "module": "Microsoft.Graph.Users",
      "cmdlets": [
        "Get-MgUser"
      ]
    }
  ]
}
