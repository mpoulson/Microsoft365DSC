{
  "resourceName": "AzurePIMRoleEligibilityScheduleRequest",
  "description": "This resource manages Azure PIM role eligibility schedule requests for Azure RBAC roles at all scope levels (subscription, management group, resource group, and resource-specific).",
  "roles": {
    "read": [
      "Privileged Role Administrator",
      "Owner"
    ],
    "update": [
      "Privileged Role Administrator",
      "Owner"
    ]
  },
  "permissions": {
    "azure": {
      "application": {
        "read": [
          {
            "name": "Microsoft.Authorization/roleEligibilitySchedules/read"
          },
          {
            "name": "Microsoft.Authorization/roleDefinitions/read"
          }
        ],
        "update": [
          {
            "name": "Microsoft.Authorization/roleEligibilityScheduleRequests/write"
          },
          {
            "name": "Microsoft.Authorization/roleEligibilitySchedules/read"
          },
          {
            "name": "Microsoft.Authorization/roleDefinitions/read"
          }
        ]
      }
    }
  },
  "requiredModules": [
    "Az.Accounts",
    "Az.Resources",
    "Microsoft.Graph.Authentication"
  ],
  "supportedEnvironments": [
    "Global",
    "USGov",
    "USGovDoD"
  ],
  "mode": "Configuration",
  "commands": [
    {
      "module": "Az.Accounts",
      "cmdlets": [
        "Invoke-AzRest",
        "Connect-AzAccount"
      ]
    },
    {
      "module": "Az.Resources",
      "cmdlets": [
        "Get-AzRoleDefinition"
      ]
    }
  ]
}
