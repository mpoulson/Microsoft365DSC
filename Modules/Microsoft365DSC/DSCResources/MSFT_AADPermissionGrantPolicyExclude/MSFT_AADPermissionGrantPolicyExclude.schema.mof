[ClassVersion("1.0.0.0"), FriendlyName("AADPermissionGrantPolicyExclude")]
class MSFT_AADPermissionGrantPolicyExclude : OMI_BaseResource
{
    [Key, Description("Identifier of the permission grant condition set.")] String Id;
    [Key, Description("Id of the permission grant policy containing this exclude condition.")] String PermissionGrantPolicyId;
    [Write, Description("Permission type for the condition set."), ValueMap{"delegated","application"}, Values{"delegated","application"}] String PermissionType;
    [Write, Description("Identifier of the resource application (API).")] String ResourceApplication;
    [Write, Description("Permissions excluded by this condition set.")] String Permissions[];
    [Write, Description("Permission classification for the condition set."), ValueMap{"low","medium","high","all"}, Values{"low","medium","high","all"}] String PermissionClassification;
    [Write, Description("Client application identifiers excluded.")] String ClientApplicationIds[];
    [Write, Description("Client application tenant identifiers excluded.")] String ClientApplicationTenantIds[];
    [Write, Description("Client application publisher identifiers excluded.")] String ClientApplicationPublisherIds[];
    [Write, Description("Only exclude client applications from verified publishers.")] Boolean ClientApplicationsFromVerifiedPublisherOnly;
    [Write, Description("Present ensures the exclude condition exists, Absent ensures it is removed."), ValueMap{"Present","Absent"}, Values{"Present","Absent"}] String Ensure;
    [Write, Description("Credentials for the Microsoft Graph delegated permissions."), EmbeddedInstance("MSFT_Credential")] String Credential;
    [Write, Description("Id of the Azure Active Directory application to authenticate with.")] String ApplicationId;
    [Write, Description("Id of the Azure Active Directory tenant used for authentication.")] String TenantId;
    [Write, Description("Secret of the Azure Active Directory application to authenticate with."), EmbeddedInstance("MSFT_Credential")] String ApplicationSecret;
    [Write, Description("Thumbprint of the Azure Active Directory application's authentication certificate to use for authentication.")] String CertificateThumbprint;
    [Write, Description("Managed ID being used for authentication.")] Boolean ManagedIdentity;
    [Write, Description("Access token used for authentication.")] String AccessTokens[];
};
