Confirm-M365DSCModuleDependency -ModuleName 'MSFT_AADAvailableExtensionProperty'

function Get-TargetResource
{
    [CmdletBinding()]
    [OutputType([System.Collections.Hashtable])]
    param
    (
        [Parameter(Mandatory = $true)]
        [System.String]
        $Name,

        [Parameter()]
        [System.String]
        $DataType,

        [Parameter()]
        [System.Boolean]
        $IsSyncedFromOnPremises,

        [Parameter()]
        [System.String[]]
        $TargetObjects,

        [Parameter()]
        [System.String]
        [ValidateSet('Present')]
        $Ensure = 'Present',

        [Parameter()]
        [System.Management.Automation.PSCredential]
        $Credential,

        [Parameter()]
        [System.String]
        $ApplicationId,

        [Parameter()]
        [System.String]
        $TenantId,

        [Parameter()]
        [System.Management.Automation.PSCredential]
        $ApplicationSecret,

        [Parameter()]
        [System.String]
        $CertificateThumbprint,

        [Parameter()]
        [Switch]
        $ManagedIdentity,

        [Parameter()]
        [System.String[]]
        $AccessTokens
    )

    Write-Verbose -Message "Getting configuration of Available Extension Property '$Name'"

    try
    {
        if (-not $Script:exportedInstance)
        {
            $null = New-M365DSCConnection -Workload 'MicrosoftGraph' `
                -InboundParameters $PSBoundParameters

            #Ensure the proper dependencies are installed in the current environment.
            Confirm-M365DSCDependencies

            #region Telemetry
            $ResourceName = $MyInvocation.MyCommand.ModuleName.Replace('MSFT_', '')
            $CommandName = $MyInvocation.MyCommand
            $data = Format-M365DSCTelemetryParameters -ResourceName $ResourceName `
                -CommandName $CommandName `
                -Parameters $PSBoundParameters
            Add-M365DSCTelemetryEvent -Data $data
            #endregion

            $nullResult = $PSBoundParameters
            $nullResult.Ensure = 'Absent'

            [array]$getValue = Get-MgBetaDirectoryObjectAvailableExtensionProperty -ErrorAction SilentlyContinue

            $instance = $getValue | Where-Object -FilterScript { $_.Name -eq $Name }

            if ($null -eq $instance)
            {
                Write-Verbose -Message "Could not find Available Extension Property with Name {$Name}"
                return $nullResult
            }
        }
        else
        {
            $instance = $Script:exportedInstance
        }
        Write-Verbose -Message "Available Extension Property with Name {$Name} was found."

        $results = @{
            Name                     = $instance.Name
            DataType                 = $instance.DataType
            IsSyncedFromOnPremises   = $instance.IsSyncedFromOnPremises
            TargetObjects            = [System.String[]]$instance.TargetObjects
            Ensure                   = 'Present'
            Credential               = $Credential
            ApplicationId            = $ApplicationId
            TenantId                 = $TenantId
            ApplicationSecret        = $ApplicationSecret
            CertificateThumbprint    = $CertificateThumbprint
            ManagedIdentity          = $ManagedIdentity.IsPresent
            AccessTokens             = $AccessTokens
        }

        return $results
    }
    catch
    {
        New-M365DSCLogEntry -Message 'Error retrieving data:' `
            -Exception $_ `
            -Source $($MyInvocation.MyCommand.Source) `
            -TenantId $TenantId `
            -Credential $Credential

        throw
    }
}

