  "permissions": {
    "graph": {
      "delegated": {
        "read": [
          {
            "name": "Policy.Read.All"
          }
        ],
        "update": [
          {
            "name": "Policy.ReadWrite.TenantGovernance"
          }
        ]
      },
      "application": {
        "read": [
          {
            "name": "Policy.Read.All"
          }
        ],
        "update": [
          {
            "name": "Policy.ReadWrite.TenantGovernance"
          }
        ]
      }
    }
  },
  "requiredModules": [
