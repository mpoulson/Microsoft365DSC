[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernancePolicyTemplateRoleTemplate
{
    [Write, Description("The template ID of the Microsoft Entra role.")] String Id;
    [Write, Description("The display name of the role.")] String Name;
};

[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernancePolicyTemplateDelegatedAdminRoleAssignment
{
    [Write, Description("The display name of the security group in the governing tenant.")] String GroupDisplayName;
    [Write, Description("The object ID of the security group in the governing tenant.")] String GroupId;
    [Write, Description("A collection of role templates that define the roles to be assigned."), EmbeddedInstance("MSFT_AADTenantGovernancePolicyTemplateRoleTemplate")] String RoleTemplates[];
};

[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernancePolicyTemplateResourcePermission
{
    [Write, Description("The permission ID.")] String Id;
    [Write, Description("The type of the permission (Role or Scope).")] String Type;
};

[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernancePolicyTemplateRequiredResourceAccess
{
    [Write, Description("The appId of the resource that the application needs to access.")] String ResourceAppId;
    [Write, Description("The collection of resource permissions required by the application."), EmbeddedInstance("MSFT_AADTenantGovernancePolicyTemplateResourcePermission")] String Permissions[];
};

[ClassVersion("1.0.0")]
class MSFT_AADTenantGovernancePolicyTemplateMultiTenantApp
{
    [Write, Description("The appId (client ID) of the multi-tenant application.")] String AppId;
    [Write, Description("The display name of the application.")] String DisplayName;
    [Write, Description("The object ID of the service principal in the governing tenant.")] String ObjectId;
    [Write, Description("The collection of resource accesses required by the application."), EmbeddedInstance("MSFT_AADTenantGovernancePolicyTemplateRequiredResourceAccess")] String RequiredResourceAccesses[];
};

[ClassVersion("1.0.0.0"), FriendlyName("AADTenantGovernancePolicyTemplate")]
class MSFT_AADTenantGovernancePolicyTemplate : OMI_BaseResource
{
    [Key, Description("The display name of the governance policy template.")] String DisplayName;
    [Write, Description("A description of the governance policy template.")] String Description;
    [Write, Description("The unique identifier for the policy template. Read-only.")] String Id;
    [Write, Description("A collection of delegated administration role assignments."), EmbeddedInstance("MSFT_AADTenantGovernancePolicyTemplateDelegatedAdminRoleAssignment")] String DelegatedAdministrationRoleAssignments[];
    [Write, Description("A collection of multi-tenant applications to provision in governed tenants."), EmbeddedInstance("MSFT_AADTenantGovernancePolicyTemplateMultiTenantApp")] String MultiTenantApplicationsToProvision[];
    [Write, Description("Present ensures the policy template exists, absent ensures it is removed."), ValueMap{"Present","Absent"}, Values{"Present","Absent"}] String Ensure;
    [Write, Description("Credentials of the Admin"), EmbeddedInstance("MSFT_Credential")] string Credential;
    [Write, Description("Id of the Azure Active Directory application to authenticate with.")] String ApplicationId;
    [Write, Description("Id of the Azure Active Directory tenant used for authentication.")] String TenantId;
    [Write, Description("Secret of the Azure Active Directory tenant used for authentication."), EmbeddedInstance("MSFT_Credential")] String ApplicationSecret;
    [Write, Description("Thumbprint of the Azure Active Directory application's authentication certificate to use for authentication.")] String CertificateThumbprint;
    [Write, Description("Managed ID being used for authentication.")] Boolean ManagedIdentity;
    [Write, Description("Access token used for authentication.")] String AccessTokens[];
};
